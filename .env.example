# EventControl settings. Copy this file to ".env" (same folder) and fill in what you need.
# Everything is optional: without a .env file the app runs fully on this computer.

# ---- Database ------------------------------------------------------------------
# Empty = SQLite file prisma/eventcontrol.db on this computer (recommended locally).
# For free cloud hosting use your Supabase Postgres "Session pooler" connection string:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---- Cloud storage (Supabase) ------------------------------------------------
# Uploaded files are copied to a Supabase Storage bucket. A local copy is always
# kept, so shows keep running without internet.
# 1. Create a project at https://supabase.com
# 2. Storage -> New bucket -> name it "eventcontrol" (keep it PRIVATE)
# 3. Project Settings -> API -> copy the URL and the service_role key below
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=eventcontrol

# ---- Access --------------------------------------------------------------------
# Empty / none = open: anyone who has the link can open and use EventControl, with no
#                password and no account (default). Share the link with your crew only.
# local        = private: an operator password, chosen on first visit.
# supabase     = private: operators sign in with a Supabase Auth user; needs SUPABASE_ANON_KEY.
AUTH_PROVIDER=
SUPABASE_ANON_KEY=
SESSION_HOURS=168

# ---- Public address (only when the UI and the API are hosted separately) -----------
# Normally the server hosts the UI too, and the app just uses whatever address it is
# opened at — leave these empty. If you put the built UI (client/dist) on a static host:
#   PUBLIC_APP_URL = where people open the UI, e.g. https://show.example.com
#   PUBLIC_API_URL = where this server is reachable, e.g. https://api.example.com
# and build the UI with VITE_API_URL=https://api.example.com (both must be https).
PUBLIC_APP_URL=
PUBLIC_API_URL=
# More browser origins allowed to call the API (comma-separated), rarely needed:
CORS_ORIGINS=

# ---- Google (Drive import, optional "Sign in with Google") -----------------------
# Create an OAuth client of type "Web application" in Google Cloud Console and add
# <every address the app is opened at>/api/auth/google/callback as Authorized redirect URI,
# e.g. https://your-app.onrender.com/api/auth/google/callback (and
# http://localhost:5173/api/auth/google/callback for development).
# With open access, each browser connects its own Google account; nobody else sees it.
# Enable the "Google Drive API" in the same project. The secret stays on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the app is reached through an address the server can't see (unusual):
GOOGLE_REDIRECT_URI=
# Private mode only: Google accounts allowed to sign in as operator (empty = off):
GOOGLE_ALLOWED_EMAILS=
# Optional: key used to encrypt stored Google tokens (random value; generated if empty).
TOKEN_ENCRYPTION_KEY=

# ---- PowerPoint conversion -----------------------------------------------------
# PPT/PPTX files are converted to slides with LibreOffice (free: https://www.libreoffice.org).
# It is found automatically; set the path only if it is installed somewhere unusual.
SOFFICE_PATH=
CONVERSION_TIMEOUT_SECONDS=180

# ---- Server --------------------------------------------------------------------
PORT=4000
MAX_UPLOAD_MB=1024
# "Open in PowerPoint" on this computer. Only ever offered to a browser on this computer.
ALLOW_EXTERNAL_OPEN=true
