# EventControl settings. Copy this file to ".env" (same folder) and fill in what you need.
# Everything is optional: without a .env file the app runs fully on this computer.

# ---- Database ------------------------------------------------------------------
# Empty = SQLite file prisma/eventcontrol.db on this computer (recommended locally).
# For free cloud hosting use your Supabase Postgres "Session pooler" connection string:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---- Cloud storage (Supabase) ------------------------------------------------
# Uploaded files are copied to a Supabase Storage bucket. A local copy is always
# kept, so shows keep running without internet.
# 1. Create a project at https://supabase.com
# 2. Storage -> New bucket -> name it "eventcontrol" (keep it PRIVATE)
# 3. Project Settings -> API -> copy the URL and the service_role key below
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=eventcontrol

# ---- Sign-in -----------------------------------------------------------------
# local    = operator password stored on this computer (default, set on first visit)
# supabase = sign in with a Supabase Auth user (email + password); needs SUPABASE_ANON_KEY
# none     = no sign-in (only on a private, trusted network)
AUTH_PROVIDER=local
SUPABASE_ANON_KEY=
SESSION_HOURS=168

# ---- Google (Drive import, optional "Sign in with Google") -----------------------
# Create an OAuth client of type "Web application" in Google Cloud Console and add this
# Authorized redirect URI:  http://localhost:5173/api/auth/google/callback
# (and your hosted address, e.g. https://your-app.onrender.com/api/auth/google/callback).
# Enable the "Google Drive API" in the same project. The secret stays on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the app is reached through an address the server can't see (unusual):
GOOGLE_REDIRECT_URI=
# Google accounts allowed to sign in as operator, comma-separated (empty = off):
GOOGLE_ALLOWED_EMAILS=
# Optional: key used to encrypt stored Google tokens (random value; generated if empty).
TOKEN_ENCRYPTION_KEY=

# ---- PowerPoint conversion -----------------------------------------------------
# PPT/PPTX files are converted to slides with LibreOffice (free: https://www.libreoffice.org).
# It is found automatically; set the path only if it is installed somewhere unusual.
SOFFICE_PATH=
CONVERSION_TIMEOUT_SECONDS=180

# ---- Server --------------------------------------------------------------------
PORT=4000
MAX_UPLOAD_MB=1024
ALLOW_EXTERNAL_OPEN=true
