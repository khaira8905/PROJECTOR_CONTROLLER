# EventControl settings. Copy this file to ".env" (same folder) and fill in what you need.
# Everything is optional: without a .env file the app runs fully on this computer.

# ---- Cloud storage (Supabase) ------------------------------------------------
# Uploaded files are copied to a Supabase Storage bucket. A local copy is always
# kept, so shows keep running without internet.
# 1. Create a project at https://supabase.com
# 2. Storage -> New bucket -> name it "eventcontrol" (keep it PRIVATE)
# 3. Project Settings -> API -> copy the URL and the service_role key below
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=eventcontrol

# ---- Sign-in -----------------------------------------------------------------
# local    = operator password stored on this computer (default, set on first visit)
# supabase = sign in with a Supabase Auth user (email + password); needs SUPABASE_ANON_KEY
# none     = no sign-in (only on a private, trusted network)
AUTH_PROVIDER=local
SUPABASE_ANON_KEY=
SESSION_HOURS=168

# ---- PowerPoint conversion -----------------------------------------------------
# PPT/PPTX files are converted to slides with LibreOffice (free: https://www.libreoffice.org).
# It is found automatically; set the path only if it is installed somewhere unusual.
SOFFICE_PATH=
CONVERSION_TIMEOUT_SECONDS=180

# ---- Server --------------------------------------------------------------------
PORT=4000
MAX_UPLOAD_MB=1024
ALLOW_EXTERNAL_OPEN=true
