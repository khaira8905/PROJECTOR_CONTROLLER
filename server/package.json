    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.1"
  }
}
